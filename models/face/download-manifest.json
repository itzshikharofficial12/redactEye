{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "description": "Model weights download manifest for RedactEye face detection pipeline",
  "models": [
    {
      "id": "face-det-slim-320",
      "filename": "det.onnx",
      "architecture": "UltraFace Slim-320 (SSD-based, with built-in anchor decoding)",
      "url": "https://github.com/Linzaer/Ultra-Light-Fast-Generic-Face-Detector-1MB/raw/master/models/onnx/version-slim-320.onnx",
      "sha256": "e9adbd0f920ddcce9368434c4d34d72520dc0c19b526fd44b4ef49bde2c3b1a8",
      "sizeBytes": 1195330,
      "inputs": [
        {
          "name": "input",
          "shape": ["1", "3", "240", "320"],
          "dtype": "float32"
        }
      ],
      "outputs": [
        {
          "name": "scores",
          "shape": ["1", "4420", "2"],
          "dtype": "float32",
          "description": "Per-anchor softmax probabilities [background_prob, face_prob]"
        },
        {
          "name": "boxes",
          "shape": ["1", "4420", "4"],
          "dtype": "float32",
          "description": "Per-anchor decoded bounding boxes [x_min, y_min, x_max, y_max] in normalized [0,1] coordinates"
        }
      ]
    }
  ]
}
